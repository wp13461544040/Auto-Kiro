    "fingerprint-injector": "^2.1.88",
    "puppeteer": "^21.6.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-repo/kirox-waf"
