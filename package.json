{
  "name": "kirox-waf-server",
  "version": "1.0.0",
  "description": "WAF 指纹加密服务 for KiroX - 基于 Apify fingerprint-suite",
  "main": "waf_server_fingerprint.js",
  "scripts": {
    "start": "node waf_server_fingerprint.js",
